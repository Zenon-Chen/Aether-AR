# ==============================================================================
# AetherMate Configuration Template
# ==============================================================================

# 1. Core Multimodal & Agent Endpoint (OpenAI-Compatible)
OMNI_API_BASE=https://maas.qianwenaiapi.com/compatible-mode/v1
OMNI_API_KEY=your_api_key_here
OMNI_MODEL=qwen3.8-omni-flash

# Optional explicit overrides for Realtime Full-Duplex WebSocket
# (Auto-derived from OMNI_API_BASE & OMNI_MODEL if left blank:
#  e.g. wss://maas.qianwenaiapi.com/api-ws/v1/realtime & qwen3.8-omni-flash-realtime)
OMNI_REALTIME_WS_URL=
OMNI_REALTIME_MODEL=
OMNI_VOICE=Tina

# 2. Tencent Hy-Memory 2.0 Configuration
# Defaults to OMNI_API_BASE / OMNI_API_KEY if left blank.
# Set MEMORY_LLM_BASE_URL=http://127.0.0.1:8000/v1 to use local vLLM Hy-Memory-30B-A3B.
MEMORY_MODE=pro
MEMORY_USER_ID=default_home_user
MEMORY_LLM_BASE_URL=
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_EMBEDDING_DIMS=1024

# 3. Server & Edge Gateway
HOST=0.0.0.0
PORT=8765
DATA_DIR=./data
